#!/bin/sh
# Launcher for web-search.ts.
#
# This must stay a POSIX sh stub, not a TypeScript file: Node only strips TS
# types from paths it recognises by extension, so an extensionless TS entry
# point fails with "SyntaxError: Unexpected strict mode reserved word" on the
# first `interface`. Switching the shebang to `tsx` does not help either --
# tsx's loader hook is also extension-matched. Keeping the implementation in
# web-search.ts and exec'ing it from here is what actually works.
#
# Both `web-search` and `web-search.ts` are therefore valid entry points.
exec node "$(cd "$(dirname "$0")" && pwd)/web-search.ts" "$@"
