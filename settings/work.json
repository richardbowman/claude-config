{
  "env": {
    "PATH": "/Users/rbowman/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash",
      "WebFetch",
      "WebSearch",
      "Write(/Users/rbowman/GitHub/bankrate-skills-e2e/*)"
    ],
    "defaultMode": "auto"
  },
  "model": "us.anthropic.claude-sonnet-5-5",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node $HOME/claude-config/bin/require-worktree.ts",
            "statusMessage": "Checking worktree..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/claude-config/bin/check-secret-staging.ts",
            "statusMessage": "Checking for secret staging..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/claude-config/bin/check-aws-auth",
            "statusMessage": "Checking AWS authentication..."
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/claude-config/bin/statusline-command.sh"
  },
  "enabledPlugins": {
    "obsidian@obsidian-skills": true,
    "slack@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "bankrate-platform@agent-plugins-for-bankrate": true
  },
  "extraKnownMarketplaces": {
    "obsidian-skills": {
      "source": {
        "source": "github",
        "repo": "kepano/obsidian-skills"
      },
      "autoUpdate": true
    },
    "agent-plugins-for-bankrate": {
      "source": {
        "source": "git",
        "url": "git@github-bankrate:bankrate/bankrate-agent-skills.git"
      }
    }
  },
  "tui": "fullscreen"
}
