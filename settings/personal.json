{
  "env": {
    "PATH": "/opt/homebrew/bin:/opt/homebrew/sbin:/Users/rickbowman/.local/bin:/Users/rickbowman/.local/share/fnm/aliases/default/bin:/Users/rickbowman/claude-config/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
  },
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(mkdir -p *)",
      "Bash(cp *)",
      "Bash(cat *)",
      "Bash(echo *)",
      "Bash(grep *)",
      "Bash(kill *)",
      "Bash(openssl *)",
      "Bash(pnpm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(tsx *)",
      "Bash(worktree-bootstrap*)",
      "Bash(curl https://www.yourhiptrip.com/*)",
      "Bash(curl http://localhost:3000/*)",
      "WebFetch",
      "WebSearch"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "/Users/rickbowman"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/require-worktree.sh",
            "statusMessage": "Checking worktree..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r 'if ((.tool_input.command // \"\") | test(\"git push\")) then {\"hookSpecificOutput\":{\"hookEventName\":\"PostToolUse\",\"additionalContext\":\"QA RUN NOTE — MANDATORY after any git push: write the run note to the vault-relative path Products/<Project>/Runs/<project-slug>-<YYYY-MM-DD>-<pr-or-topic>.md (append to the note for today if one exists, else create it) under a heading of the form: ## QA Report — <HH:MM>. Record only OBSERVED output — paste the real pass/fail counts from commands you actually ran this session; never carry results over from a prior session, a summary, or memory. Mark anything unverified as NOT VERIFIED. Embed screenshots as images from Attachments/QA/<Project>/<YYYY-MM-DD>-<slug>/. Add a wikilink to the note in Daily/<YYYY-MM-DD>.md under ## Claude Sessions. State the exact vault path you wrote in your reply — that path is the only durable evidence the work happened.\"}} | tojson else empty end'",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/claude-config/bin/check-aws-auth",
            "statusMessage": "Checking AWS authentication..."
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/claude-config/bin/log-instructions-loaded",
            "statusMessage": "Logging loaded instructions..."
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/claude-config/bin/statusline-command.sh"
  },
  "enabledPlugins": {
    "obsidian@obsidian-skills": true,
    "compass@compass": true
  },
  "extraKnownMarketplaces": {
    "obsidian-skills": {
      "source": {
        "source": "github",
        "repo": "kepano/obsidian-skills"
      },
      "autoUpdate": true
    },
    "compass": {
      "source": {
        "source": "github",
        "repo": "rbcodelabs/compass"
      }
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "mcpServers": {
    "helio": {
      "type": "http",
      "url": "https://helios.rbcodelabs.com/api/mcp"
    },
    "compass": {
      "type": "http",
      "url": "https://compass.rbcodelabs.com/api/mcp",
      "headers": {
        "Authorization": "Bearer ${COMPASS_MCP_API_KEY}"
      }
    },
    "hiptrip": {
      "type": "http",
      "url": "https://www.yourhiptrip.com/api/mcp",
      "headers": {
        "x-api-key": "${HIPTRIP_MCP_KEY}"
      }
    }
  }
}
